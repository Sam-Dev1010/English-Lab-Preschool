---
interface Props {
  bookId: string;
  color: string;
  title: string;
  totalPages?: number;
}

const { bookId, color, title, totalPages = 6 } = Astro.props;
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<div class="flipbook-wrapper">
  <div class="flipbook-stage">
    <div class="flipbook-viewer" id={`viewer-${bookId}`}>
      {pages.map((num, i) => (
        <div class:list={["viewer-page", { active: i === 0 }]} data-page={i}>
          <img src={`/pages/${bookId}/page-${String(num).padStart(4, '0')}.jpg`} alt={`${title} — Página ${num}`} loading={i === 0 ? "eager" : "lazy"} draggable="false" />
        </div>
      ))}
    </div>
  </div>

  <div class="flipbook-controls">
    <button class="flip-btn" id={`prev-${bookId}`} disabled>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      <span data-i18n="flipbook.prev">Anterior</span>
    </button>
    <span class="flip-counter" id={`counter-${bookId}`}>1 / {totalPages}</span>
    <button class="flip-btn" id={`next-${bookId}`}>
      <span data-i18n="flipbook.next">Siguiente</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
</div>

<style>
  .flipbook-wrapper {
    margin: 24px 0 40px;
  }
  .flipbook-stage {
    display: flex;
    justify-content: center;
    overflow: hidden;
  }
  .flipbook-viewer {
    width: min(100%, 720px, calc((100vh - 260px) * 4 / 3));
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.12);
    background: #ffffff;
    position: relative;
    aspect-ratio: 4 / 3;
    perspective: 1200px;
  }
  .viewer-page {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transform-origin: left center;
    transition: none;
    backface-visibility: hidden;
  }
  .viewer-page.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }
  .viewer-page.flip-out-forward {
    animation: flipOutForward 0.6s ease-in forwards;
    z-index: 3;
    opacity: 1;
    visibility: visible;
  }
  .viewer-page.flip-in-forward {
    animation: flipInForward 0.6s ease-out forwards;
    z-index: 1;
  }
  .viewer-page.flip-out-backward {
    animation: flipOutBackward 0.6s ease-in forwards;
    z-index: 1;
    opacity: 1;
    visibility: visible;
  }
  .viewer-page.flip-in-backward {
    animation: flipInBackward 0.6s ease-out forwards;
    z-index: 3;
  }
  .viewer-page img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    background: #ffffff;
    pointer-events: none;
    user-select: none;
  }
  @keyframes flipOutForward {
    0% {
      transform: rotateY(0deg);
      opacity: 1;
      box-shadow: none;
    }
    30% {
      box-shadow: -10px 0 40px rgba(0, 0, 0, 0.4);
    }
    100% {
      transform: rotateY(-110deg);
      opacity: 0;
      box-shadow: none;
    }
  }
  @keyframes flipInForward {
    0% {
      transform: rotateY(110deg);
      opacity: 0;
    }
    30% {
      box-shadow: 10px 0 40px rgba(0, 0, 0, 0.4);
    }
    100% {
      transform: rotateY(0deg);
      opacity: 1;
      box-shadow: none;
    }
  }
  @keyframes flipOutBackward {
    0% {
      transform: rotateY(0deg);
      opacity: 1;
      box-shadow: none;
    }
    30% {
      box-shadow: 10px 0 40px rgba(0, 0, 0, 0.4);
    }
    100% {
      transform: rotateY(110deg);
      opacity: 0;
      box-shadow: none;
    }
  }
  @keyframes flipInBackward {
    0% {
      transform: rotateY(-110deg);
      opacity: 0;
    }
    30% {
      box-shadow: -10px 0 40px rgba(0, 0, 0, 0.4);
    }
    100% {
      transform: rotateY(0deg);
      opacity: 1;
      box-shadow: none;
    }
  }
  .flipbook-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 16px;
  }
  .flip-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border: 2px solid #e8e4de;
    background: white;
    border-radius: 50px;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.25s;
    color: #2d2d2d;
  }
  .flip-btn:hover:not(:disabled) {
    border-color: var(--orange);
    color: var(--orange);
    transform: translateY(-1px);
  }
  .flip-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  .flip-counter {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    color: #8a8a8a;
    font-size: 0.95rem;
    min-width: 60px;
    text-align: center;
  }

  @media (max-width: 768px) {
    .flipbook-viewer {
      border-radius: 10px;
    }
    .flipbook-controls {
      gap: 12px;
    }
    .flip-btn {
      padding: 10px 16px;
      font-size: 0.8rem;
      gap: 4px;
    }
    .flip-btn svg {
      width: 14px;
      height: 14px;
    }
    .flip-counter {
      font-size: 0.85rem;
      min-width: 50px;
    }
  }
</style>

<script define:vars={{ bookId, totalPages }}>
  (function() {
    let current = 0;
    let isAnimating = false;
    const viewer = document.getElementById(`viewer-${bookId}`);
    const pages = viewer?.querySelectorAll('.viewer-page') || [];
    const prevBtn = document.getElementById(`prev-${bookId}`);
    const nextBtn = document.getElementById(`next-${bookId}`);
    const counter = document.getElementById(`counter-${bookId}`);

    function updateButtons() {
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current >= totalPages - 1;
      counter.textContent = `${current + 1} / ${totalPages}`;
    }

    function goToPage(newIndex, direction) {
      if (isAnimating || newIndex === current || newIndex < 0 || newIndex >= totalPages) return;
      isAnimating = true;

      const oldPage = pages[current];
      const newPage = pages[newIndex];

      if (direction === 'forward') {
        oldPage.classList.remove('active');
        oldPage.classList.add('flip-out-forward');
        newPage.classList.add('flip-in-forward');
      } else {
        oldPage.classList.remove('active');
        oldPage.classList.add('flip-out-backward');
        newPage.classList.add('flip-in-backward');
      }

      newPage.style.visibility = 'visible';
      newPage.style.opacity = '1';

      setTimeout(() => {
        oldPage.classList.remove('flip-out-forward', 'flip-out-backward', 'active');
        oldPage.style.visibility = '';
        oldPage.style.opacity = '';
        newPage.classList.remove('flip-in-forward', 'flip-in-backward');
        newPage.classList.add('active');
        current = newIndex;
        updateButtons();
        isAnimating = false;
      }, 600);
    }

    updateButtons();

    prevBtn?.addEventListener('click', () => goToPage(current - 1, 'backward'));
    nextBtn?.addEventListener('click', () => goToPage(current + 1, 'forward'));

    let touchStartX = 0;
    let touchEndX = 0;
    viewer?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    viewer?.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) goToPage(current + 1, 'forward');
        else goToPage(current - 1, 'backward');
      }
    }, { passive: true });
  })();
</script>
