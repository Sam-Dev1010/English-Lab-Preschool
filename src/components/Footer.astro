---
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/logos/LOGO EMPRENDER EDICIONES.jpg" alt="Emprender Ediciones" class="footer-logo" />
      <p class="footer-text" data-i18n="footer.desc">Serie English Lab — Libros de inglés para preescolar</p>
      <p class="footer-copy">&copy; {new Date().getFullYear()} Emprender Ediciones. <span data-i18n="footer.copy">Todos los derechos reservados.</span></p>
    </div>
    <div class="footer-links">
      <div class="footer-col">
        <h4 data-i18n="footer.books">Libros</h4>
        <a href="/books/a">English Lab A</a>
        <a href="/books/b">English Lab B</a>
        <a href="/books/c">English Lab C</a>
      </div>
      <div class="footer-col">
        <h4 data-i18n="footer.links">Enlaces</h4>
        <a href="/songs" data-i18n="nav.songs">Canciones</a>
        <a href="/phonetics" data-i18n="nav.phonetics">Fonética</a>
        <a href="/workshops" class="teacher-only" data-i18n="nav.workshops">Ayudas Pedagógicas</a>
        <a href="#" class="change-role" id="change-role" data-i18n="footer.changeRole">Cambiar rol</a>
        <a href="/about" data-i18n="nav.about">Nosotros</a>
        <a href="/contact" data-i18n="nav.contact">Contacto</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: var(--white);
    padding: 60px 0 32px;
    margin-top: auto;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
  }
  .footer-logo {
    max-height: 64px;
    max-width: 200px;
    width: auto;
    object-fit: contain;
    margin-bottom: 16px;
  }
  .footer-text {
    color: #aaa;
    font-size: 0.95rem;
    margin-bottom: 8px;
  }
  .footer-copy {
    color: #666;
    font-size: 0.85rem;
  }
  .footer-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .footer-col h4 {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    margin-bottom: 16px;
    color: var(--yellow);
    font-size: 1rem;
  }
  .footer-col a {
    display: block;
    color: #aaa;
    padding: 4px 0;
    transition: var(--transition);
    font-size: 0.95rem;
  }
  .footer-col a:hover {
    color: var(--white);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: center;
    }
    .footer-links {
      justify-items: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const changeRole = document.getElementById('change-role');
    changeRole?.addEventListener('click', e => {
      e.preventDefault();
      localStorage.removeItem('english-lab-role');
      window.location.reload();
    });
  });
</script>
