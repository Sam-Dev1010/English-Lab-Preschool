---
import '../styles/global.css';
import { t } from '../i18n/index';

interface Props {
  title: string;
  description?: string;
}

const { title, description = t('footer.desc') } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/jpeg" href="/logos/LOGO EMPRENDER EDICIONES.jpg" />
  <title>{title} | English Lab</title>
</head>
<body>
  <slot />
</body>
</html>