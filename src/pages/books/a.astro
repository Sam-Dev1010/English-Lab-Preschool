---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FlipBook from '../../components/FlipBook.astro';
import Footer from '../../components/Footer.astro';
import { t } from '../../i18n/index';

const songs = [
  { name: 'Big Small', file: 'a-01.mp3' },
  { name: 'Color Song', file: 'a-02.mp3' },
  { name: 'Goodbye Song', file: 'a-03.mp3' },
  { name: 'Good Morning', file: 'a-04.mp3' },
  { name: 'Hello!', file: 'a-05.mp3' },
  { name: 'I Can Sing A Rainbow', file: 'a-06.mp3' },
  { name: 'I See Something Blue', file: 'a-07.mp3' },
  { name: 'Long and Short', file: 'a-08.mp3' },
  { name: 'My Teddy Bear', file: 'a-09.mp3' },
  { name: 'My Toys', file: 'a-10.mp3' },
  { name: 'Open Close!', file: 'a-11.mp3' },
  { name: 'Open Shut Them', file: 'a-12.mp3' },
  { name: 'Orange Song', file: 'a-13.mp3' },
  { name: 'Parts Of The Face', file: 'a-14.mp3' },
  { name: 'Purple Song', file: 'a-15.mp3' },
  { name: 'Sports Balls Song', file: 'a-16.mp3' },
  { name: 'The Animals On The Farm', file: 'a-17.mp3' },
  { name: 'The Color Green Song', file: 'a-18.mp3' },
  { name: 'The Finger Family', file: 'a-19.mp3' },
  { name: 'The Pinocchio', file: 'a-20.mp3' },
  { name: 'The Yellow Song', file: 'a-21.mp3' },
  { name: 'Touch Your Head', file: 'a-22.mp3' },
  { name: 'Two Eyes Two Ears', file: 'a-23.mp3' },
  { name: 'Whose Eyes', file: 'a-24.mp3' },
];
---

<Layout title="English Lab A — Prejardín">
  <Header />

  <section class="book-hero">
    <div class="container book-hero-inner">
      <div class="book-hero-info">
        <span class="badge badge-a" data-i18n="books.badgeA">Pre-K</span>
        <h1>English Lab <span style="color: var(--yellow)">A</span></h1>
        <p class="book-hero-desc" data-i18n="books.heroDesc">
          This series is designed to accompany children in preschool, 
          covering the formative fields of the Preschool Education Program: 
          Personal and social development, Language and communication, Mathematical thinking, 
          Exploration and knowledge of the world, Artistic expression and appreciation, 
          and Physical development and health.
        </p>
        <div class="book-hero-meta">
          <div class="meta-item">
            <strong data-i18n="books.level">Level:</strong> <span data-i18n="books.badgeA">Pre-K</span>
          </div>
          <div class="meta-item">
            <strong data-i18n="books.focus">Focus:</strong> <span data-i18n="books.focusA">Play, music, exploration</span>
          </div>
          <div class="meta-item">
            <strong data-i18n="books.songs">Songs:</strong> {songs.length} <span data-i18n="books.included">included</span>
          </div>
        </div>
      </div>
      <div class="book-hero-cover">
        <div class="cover-glow" style="background: radial-gradient(circle, rgba(245, 197, 24, 0.3), transparent 70%)"></div>
        <img src="/covers/cover-a.jpg" alt="English Lab A" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" data-i18n="books.previewTitle">Vista Previa del Libro</h2>
      <p class="section-subtitle" data-i18n="books.previewDesc">Hojear las páginas de ejemplo de English Lab A</p>
      <FlipBook bookId="a" color="#F5C518" title="English Lab A" totalPages={8} />
    </div>
  </section>

  <section class="section songs-section">
    <div class="container">
      <h2 class="section-title" data-i18n="books.songsTitle">Canciones del Libro A</h2>
      <p class="section-subtitle" data-i18n="books.songsDescDetail">Escucha las canciones que acompañan el aprendizaje</p>
      <div class="songs-grid">
        {songs.map((song, i) => (
          <div class="song-item">
            <div class="audio-player">
              <button class="play-btn" data-audio={`a-${i}`} aria-label={t('books.play')}>
                <svg class="play-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                <svg class="pause-icon" viewBox="0 0 24 24" fill="currentColor" style="display:none">
                  <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                </svg>
              </button>
              <div class="player-body">
                <span class="player-name">{song.name}</span>
                <div class="player-progress-wrap">
                  <div class="player-progress-bar">
                    <div class="player-progress-fill"></div>
                  </div>
                  <span class="player-time">0:00</span>
                </div>
              </div>
              <audio data-id={`a-${i}`} src={`/audio/${song.file}`} preload="metadata"></audio>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .book-hero {
    padding: 60px 0;
    background:
      radial-gradient(circle at 20% 50%, rgba(245, 197, 24, 0.1) 0%, transparent 50%);
  }
  .book-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .book-hero-info h1 {
    margin: 16px 0;
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .book-hero-desc {
    font-size: 1.05rem;
    color: #555;
    margin-bottom: 24px;
    line-height: 1.7;
  }
  .book-hero-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .meta-item {
    font-size: 0.95rem;
    color: #666;
  }
  .meta-item strong {
    color: var(--dark);
  }
  .book-hero-cover {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .cover-glow {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    filter: blur(40px);
  }
  .book-hero-cover img {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 2123 / 1461;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
  }

  .songs-section {
    background: var(--white);
  }
  .songs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 12px;
  }
  .audio-player {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 18px;
    background: var(--cream);
    border-radius: 14px;
    transition: var(--transition);
  }
  .audio-player:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }
  .play-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: var(--yellow);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: var(--transition);
  }
  .play-btn:hover {
    transform: scale(1.05);
  }
  .play-icon, .pause-icon {
    width: 20px;
    height: 20px;
  }
  .player-body {
    flex: 1;
    min-width: 0;
  }
  .player-name {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    display: block;
    margin-bottom: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .player-progress-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .player-progress-bar {
    flex: 1;
    height: 6px;
    background: var(--gray-light);
    border-radius: 6px;
    cursor: pointer;
    overflow: hidden;
  }
  .player-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--yellow), var(--orange));
    border-radius: 6px;
    transition: width 0.1s linear;
  }
  .player-time {
    font-size: 0.75rem;
    color: var(--gray);
    font-weight: 600;
    min-width: 36px;
    text-align: right;
  }

  @media (max-width: 768px) {
    .book-hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .book-hero-meta {
      align-items: center;
    }
    .songs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll('.play-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-audio');
      const audio = document.querySelector(`audio[data-id="${id}"]`) as HTMLAudioElement;
      const playIcon = btn.querySelector('.play-icon') as HTMLElement;
      const pauseIcon = btn.querySelector('.pause-icon') as HTMLElement;
      const fill = btn.closest('.audio-player')?.querySelector('.player-progress-fill') as HTMLElement;
      const timeEl = btn.closest('.audio-player')?.querySelector('.player-time') as HTMLElement;

      if (!audio) return;

      if (!audio.paused) {
        audio.pause();
        playIcon.style.display = '';
        pauseIcon.style.display = 'none';
      } else {
        document.querySelectorAll('audio').forEach(a => a.pause());
        document.querySelectorAll('.play-icon').forEach(i => (i as HTMLElement).style.display = '');
        document.querySelectorAll('.pause-icon').forEach(i => (i as HTMLElement).style.display = 'none');
        audio.play();
        playIcon.style.display = 'none';
        pauseIcon.style.display = '';
      }

      audio.addEventListener('timeupdate', () => {
        if (audio.duration && fill && timeEl) {
          fill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
          const m = Math.floor(audio.currentTime / 60);
          const s = Math.floor(audio.currentTime % 60);
          timeEl.textContent = `${m}:${s.toString().padStart(2, '0')}`;
        }
      });

      audio.addEventListener('ended', () => {
        playIcon.style.display = '';
        pauseIcon.style.display = 'none';
        if (fill) fill.style.width = '0%';
        if (timeEl) timeEl.textContent = '0:00';
      });
    });
  });
</script>
