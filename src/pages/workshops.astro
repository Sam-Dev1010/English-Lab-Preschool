---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/index';

const pages = Array.from({ length: 60 }, (_, i) => i + 1);
const pageLabel = (n: number) => String(n).padStart(2, '0');
---

<Layout title={t('workshops.title')}>
  <Header />

  <section class="page-hero">
    <div class="container">
      <h1><span class="highlight" data-i18n="workshops.title">Ayudas Pedagógicas</span></h1>
      <p data-i18n="workshops.subtitle">Descarga los workshops de la serie English Lab para acompañar el aprendizaje de los niños en el aula y en casa.</p>
    </div>
  </section>

  <section class="section pages-section">
    <div class="container">
      <h2 class="section-title" data-i18n="workshops.pagesSection">Hojas de trabajo</h2>

      <div class="pages-grid">
        {pages.map((num) => {
          const label = pageLabel(num);
          return (
            <div class="page-card">
              <button type="button" class="page-thumb" data-open-modal={label} aria-label={`Workshop ${label}`}>
                <img src={`/workshops/thumbs/thumb-${label}.jpg`} alt={`Workshop ${label}`} loading="lazy" />
              </button>
              <div class="page-card-body">
                <span class="page-label" data-i18n="workshops.pageLabel">Página</span>
                <strong>{label}</strong>
                <a href={`/workshops/pages/workshop-${label}.pdf`} download={`workshop-${label}.pdf`} class="btn btn-primary page-download">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                  <span data-i18n="workshops.downloadPage">Descargar hoja</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <div class="lightbox" id="page-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="lightbox-backdrop" data-close></div>
    <div class="lightbox-content">
      <img id="page-lightbox-img" src="" alt="" draggable="false" />
      <div class="lightbox-toolbar">
        <button class="lightbox-btn download-btn" id="page-lightbox-download">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span data-i18n="workshops.downloadPage">Descargar hoja</span>
        </button>
        <button class="lightbox-btn lightbox-close" data-close aria-label="Cerrar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>
  </div>

  <section class="section cta-section">
    <div class="container cta-inner">
      <h2 data-i18n="workshops.ctaTitle">¿Tienes preguntas?</h2>
      <p data-i18n="workshops.ctaDesc">Estamos aquí para ayudarte. Contáctanos y con gusto atenderemos tus consultas.</p>
      <a href="https://wa.me/573214649099" target="_blank" class="btn btn-primary" style="background: #25D366; border-color: #25D366">WhatsApp</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 60px 0 40px;
    text-align: center;
    background:
      radial-gradient(circle at 30% 50%, rgba(245, 197, 24, 0.1) 0%, transparent 50%);
  }
  .page-hero h1 { margin-bottom: 16px; }
  .highlight {
    background: linear-gradient(135deg, var(--orange), var(--red));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .page-hero p {
    max-width: 560px;
    margin: 0 auto;
    font-size: 1.1rem;
    color: #555;
  }
  .workshops-note {
    text-align: center;
    margin-top: 40px;
    font-size: 0.95rem;
    color: var(--gray);
  }
  .pages-section {
    background: var(--white);
  }
  .pages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 20px;
  }
  .page-card {
    background: var(--cream);
    border: 1px solid var(--gray-light);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: var(--transition);
  }
  .page-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .page-thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    cursor: zoom-in;
    aspect-ratio: 538.583 / 737.008;
    overflow: hidden;
    background: #fff;
  }
  .page-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .page-card-body {
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .page-label {
    font-size: 0.85rem;
    color: var(--gray);
    font-weight: 600;
  }
  .page-card-body strong {
    font-family: 'Nunito', sans-serif;
    font-size: 1rem;
    color: var(--dark);
  }
  .page-download {
    margin-left: auto;
    padding: 8px 14px;
    font-size: 0.8rem;
  }
  @media (max-width: 640px) {
    .pages-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 14px;
    }
    .page-download {
      width: 100%;
      margin-left: 0;
      justify-content: center;
    }
  }
  .cta-section {
    background: linear-gradient(135deg, var(--green), var(--blue));
    color: var(--white);
    text-align: center;
  }
  .cta-inner h2 { color: var(--white); margin-bottom: 12px; }
  .cta-inner p { color: rgba(255,255,255,0.85); margin-bottom: 24px; }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .lightbox.open {
    display: flex;
  }
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    animation: lightboxFadeIn 0.25s ease;
  }
  .lightbox-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    animation: lightboxZoomIn 0.25s ease;
  }
  .lightbox-content img {
    max-width: 92vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.55);
  }
  .lightbox-toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lightbox-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 26px;
    border: none;
    border-radius: 50px;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.25s;
    color: #ffffff;
  }
  .lightbox-btn.download-btn {
    background: var(--orange);
  }
  .lightbox-btn.download-btn:hover {
    background: var(--red);
    transform: translateY(-1px);
  }
  .lightbox-btn.lightbox-close {
    background: rgba(255, 255, 255, 0.12);
    border: 2px solid rgba(255, 255, 255, 0.35);
    padding: 12px 16px;
  }
  .lightbox-btn.lightbox-close:hover {
    background: rgba(255, 255, 255, 0.28);
  }
  @keyframes lightboxFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes lightboxZoomIn {
    from { transform: scale(0.94); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const role = sessionStorage.getItem('english-lab-role');
    if (role !== 'teacher') {
      window.location.href = '/';
      return;
    }

    const lightbox = document.getElementById('page-lightbox') as HTMLElement | null;
    const lightboxImg = document.getElementById('page-lightbox-img') as HTMLImageElement | null;
    const downloadBtn = document.getElementById('page-lightbox-download') as HTMLElement | null;
    let currentLabel = '';

    function openLightbox(label: string) {
      const btn = document.querySelector(`[data-open-modal="${label}"]`);
      const img = btn?.querySelector('img') as HTMLImageElement | null;
      if (!img || !lightbox || !lightboxImg) return;
      currentLabel = label;
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt || '';
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('[data-open-modal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const label = btn.getAttribute('data-open-modal');
        if (label) openLightbox(label);
      });
    });

    lightbox?.querySelectorAll('[data-close]').forEach((el) => {
      el.addEventListener('click', closeLightbox);
    });

    downloadBtn?.addEventListener('click', () => {
      if (!currentLabel) return;
      const a = document.createElement('a');
      a.href = `/workshops/pages/workshop-${currentLabel}.pdf`;
      a.download = `workshop-${currentLabel}.pdf`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  });
</script>
