---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/index';
---

<Layout title={t('workshops.title')}>
  <Header />

  <section class="page-hero">
    <div class="container">
      <h1><span class="highlight" data-i18n="workshops.title">Ayudas Pedagógicas</span></h1>
      <p data-i18n="workshops.subtitle">Descarga los workshops de la serie English Lab para acompañar el aprendizaje de los niños en el aula y en casa.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" data-i18n="workshops.sectionTitle">Workshops para descargar</h2>
      <p class="section-subtitle" data-i18n="workshops.sectionSubtitle">Material práctico listo para imprimir y usar en clase</p>

      <div class="workshops-grid">
        <article class="workshop-card">
          <div class="workshop-icon">📄</div>
          <span class="badge badge-b" data-i18n="workshops.badge">PDF</span>
          <h3 data-i18n="workshops.item1Title">Workshops 01-60</h3>
          <p data-i18n="workshops.item1Desc">60 workshops de actividades para preescolar, alineados con los niveles A, B y C de la serie English Lab.</p>
          <ul class="workshop-meta">
            <li data-i18n="workshops.pages">60 páginas</li>
            <li>PDF · 17 MB</li>
          </ul>
          <a href="/workshops/workshops-01-60.pdf" download class="btn btn-primary workshop-download">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span data-i18n="workshops.download">Descargar PDF</span>
          </a>
        </article>
      </div>

      <p class="workshops-note" data-i18n="workshops.note">¿Necesitas material personalizado para tu institución? Escríbenos por WhatsApp.</p>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-inner">
      <h2 data-i18n="workshops.ctaTitle">¿Tienes preguntas?</h2>
      <p data-i18n="workshops.ctaDesc">Estamos aquí para ayudarte. Contáctanos y con gusto atenderemos tus consultas.</p>
      <a href="https://wa.me/573214649099" target="_blank" class="btn btn-primary" style="background: #25D366; border-color: #25D366">WhatsApp</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 60px 0 40px;
    text-align: center;
    background:
      radial-gradient(circle at 30% 50%, rgba(245, 197, 24, 0.1) 0%, transparent 50%);
  }
  .page-hero h1 { margin-bottom: 16px; }
  .highlight {
    background: linear-gradient(135deg, var(--orange), var(--red));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .page-hero p {
    max-width: 560px;
    margin: 0 auto;
    font-size: 1.1rem;
    color: #555;
  }
  .workshops-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    max-width: 420px;
    margin: 0 auto;
  }
  .workshop-card {
    padding: 40px 32px;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--gray-light);
    box-shadow: var(--shadow);
    text-align: center;
    transition: var(--transition);
  }
  .workshop-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .workshop-icon {
    width: 72px;
    height: 72px;
    border-radius: 20px;
    background: #FFF3D6;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 16px;
  }
  .badge {
    margin-bottom: 12px;
  }
  .workshop-card h3 {
    margin-bottom: 12px;
    font-size: 1.25rem;
  }
  .workshop-card p {
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 16px;
  }
  .workshop-meta {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    justify-content: center;
    gap: 16px;
    font-size: 0.85rem;
    color: var(--gray);
  }
  .workshop-meta li {
    background: var(--cream);
    padding: 4px 14px;
    border-radius: 50px;
    font-weight: 600;
  }
  .workshop-download {
    width: 100%;
    justify-content: center;
  }
  .workshops-note {
    text-align: center;
    margin-top: 40px;
    font-size: 0.95rem;
    color: var(--gray);
  }
  .cta-section {
    background: linear-gradient(135deg, var(--green), var(--blue));
    color: var(--white);
    text-align: center;
  }
  .cta-inner h2 { color: var(--white); margin-bottom: 12px; }
  .cta-inner p { color: rgba(255,255,255,0.85); margin-bottom: 24px; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const role = sessionStorage.getItem('english-lab-role');
    if (role !== 'teacher') {
      window.location.href = '/';
    }
  });
</script>
